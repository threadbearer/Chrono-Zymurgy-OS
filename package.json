  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
